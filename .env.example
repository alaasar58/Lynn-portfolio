# Endpoint the inquiry form posts to (Formspree, Getform, Basin, Netlify Forms…).
# Leave unset and the form falls back to opening a pre-filled email instead.
VITE_FORM_ENDPOINT=

# Path the site is served from.
#   "/"          local dev, custom domain, Netlify, Vercel
#   "/<repo>/"   GitHub Pages project site (set automatically by the deploy workflow)
VITE_BASE=/
